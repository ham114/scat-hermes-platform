# Copy to .env locally. Never commit actual credentials or deployment endpoints.
# Empty values do not override Settings defaults (env_ignore_empty=True).
# This template is for local development behind Nginx; see docs/DEPLOYMENT.md.
# Phase 1 uses external DeepSeek; local llama-server is optional and not started.
MODE=dev
HOST=127.0.0.1
PORT=18080
LOG_LEVEL=INFO

# Server-only Bearer credential. Generate a distinct value before team deployment.
AUTH_SECRET=
ANALYSIS_IDENTITY_MODE=disabled
ANALYSIS_SINGLE_USER_ID=
ANALYSIS_LEGACY_OWNER_ID=

# Business MongoDB. Blank uses the code's local development defaults.
FLIGHT_MONGO_URI=
FLIGHT_MONGO_DB=

# Conversation checkpoints. Persistent paths are selected by the operator.
DATABASE_TYPE=sqlite
SQLITE_DB_PATH=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_DB=
MONGO_HOST=
MONGO_PORT=
MONGO_DB=
MONGO_USER=
MONGO_PASSWORD=
MONGO_AUTH_SOURCE=
MONGO_TLS=false

# Select one language-model provider for the full Agent service.
# The deterministic data API does not require a provider.
DEFAULT_MODEL=deepseek-flash
OPENAI_API_KEY=
# Fill this one key for the default external LLM.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
COMPATIBLE_MODEL=
COMPATIBLE_API_KEY=
COMPATIBLE_BASE_URL=
OLLAMA_MODEL=
OLLAMA_BASE_URL=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT_MAP=
GOOGLE_APPLICATION_CREDENTIALS=
USE_AWS_BEDROCK=false
USE_FAKE_MODEL=false

# Optional external prediction backend. No model source, weights or configuration
# are distributed here. Keep disabled until the full private setup is available.
SCAT_GBAR_V23_ENABLED=false
SCAT_GBAR_V23_BACKEND=subprocess
SCAT_GBAR_V23_BENTO_ENDPOINT=
SCAT_GBAR_V23_BENTO_RELEASE_ID=
SCAT_GBAR_V23_BENTO_SOURCE_TREE_SHA256=
SCAT_GBAR_V23_BENTO_RUNTIME_SHA256=
SCAT_GBAR_V23_BENTO_SCHEMA_SHA256=
SCAT_GBAR_V23_PYTHON_EXECUTABLE=
SCAT_GBAR_V23_WORKER_SCRIPT=
SCAT_GBAR_V23_SOURCE_DIR=
SCAT_GBAR_V23_CONFIG=
SCAT_GBAR_V23_CHECKPOINT=
SCAT_GBAR_V23_SOURCE_URI=
SCAT_GBAR_V23_WORKER_SCRIPT_SHA256=
SCAT_GBAR_V23_CONFIG_SHA256=
SCAT_GBAR_V23_CHECKPOINT_SHA256=
SCAT_GBAR_V23_DEVICE=
SCAT_GBAR_V23_COMPARISON_SUBPROCESS_ENABLED=false
SCAT_GBAR_V23_SHADOW_REFERENCES=[]
SCAT_GBAR_V23_SHADOW_REPORT_DIR=
SCAT_GBAR_V23_OBSERVE=false

# Optional external retrieval service, disabled without private corpus/index setup.
SCAT_RAG_BASELINE_ENABLED=false
SCAT_RAG_BASELINE_URL=
REDIS_URL=

# Public navigation URLs only. Never use VITE_* for server credentials.
AGENT_URL=
PORTAL_URL=
ANALYSIS_VISUALIZATION_BASE_URL=
ANALYSIS_CODE_VERSION=
SCAT_EXPERIMENT_ARTIFACT_DIR=

# Optional integrations; credentials are supplied outside version control.
GITHUB_PAT=
OPENWEATHERMAP_API_KEY=
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGFUSE_TRACING=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
VOICE_STT_PROVIDER=
VOICE_TTS_PROVIDER=

# Private Hermes runtime (start scripts/run_hermes_api.py first)
HERMES_BASE_URL=http://127.0.0.1:18081
HERMES_API_KEY_FILE=var/secrets/hermes-api.key
HERMES_STATE_FILE=var/platform/hermes.sqlite
HERMES_RESULT_STATE_FILE=var/platform/hermes-results.sqlite

# H5 durable confirmations and independent model-worker outbox; project-relative.
HERMES_TASK_STATE_FILE=var/platform/model-tasks.sqlite

# S6 new-request defaults. Upgrade with a distinct Hermes home; explicit false enables historical platform compatibility.
HERMES_SKILL_JOBS_ENABLED=true
HERMES_WORKFLOWS_ENABLED=true

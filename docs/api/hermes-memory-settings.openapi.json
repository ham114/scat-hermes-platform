  "components": {
    "schemas": {
      "Correction": {
        "properties": {
          "request_id": {
            "type": "string",
            "format": "uuid",
            "title": "Request Id"
          },
          "content": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Content"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_id",
          "content"
        ],
        "title": "Correction"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Proposal": {
        "properties": {
          "section": {
            "type": "string",
            "maxLength": 32,
            "minLength": 1,
            "title": "Section"
          },
          "changes": {
            "additionalProperties": true,
            "type": "object",
            "maxProperties": 8,
            "minProperties": 1,
            "title": "Changes"
          },
          "expected_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "title": "Expected Sha256"
          },
          "request_id": {
            "type": "string",
            "title": "Request Id"
          },
          "confirmed": {
            "type": "boolean",
            "title": "Confirmed",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "section",
          "changes",
          "expected_sha256",
          "request_id"
        ],
        "title": "Proposal"
      },
      "Settings": {
        "properties": {
          "enabled": {
            "type": "boolean",
            "title": "Enabled"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "enabled"
        ],
        "title": "Settings"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "description": "Please provide AUTH_SECRET api key.",
        "scheme": "bearer"
      }
    }
  }
}

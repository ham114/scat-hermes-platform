{
  "schema_version": 1,
  "release": "s4.0.0",
  "artifact_schema": "model-step-artifact/v1",
  "reference_schema": "model-step-reference/v1",
  "maximum_artifact_bytes": 16777216,
  "operations": [
    {
      "name": "scat_model_prepare_input",
      "version": "1.0.0",
      "description": "准备可信任务已固定的模型输入；不接受模型、数据或 confirmed 等聊天授权参数。",
      "parameters": {
        "additionalProperties": false,
        "properties": {},
        "title": "Empty",
        "type": "object"
      },
      "input_kind": null,
      "output_kind": "input",
      "effect_kind": "derived_write",
      "environment_alias": "scat-agent",
      "supervisor_timeout_seconds": 20,
      "native_timeout_seconds": 25,
      "model_timeout": "ModelSpec.resource_limits.timeout_seconds",
      "idempotency": "scope + run + sha256(operation, canonical arguments); success reuses receipt; running/unknown/failed never auto-reexecutes",
      "evidence_fields": [
        "scope",
        "run",
        "operation",
        "step_key",
        "state",
        "reference",
        "error",
        "job_id",
        "lease_generation",
        "delegation_id",
        "budget_revision",
        "backend_execution_id"
      ],
      "output_contract": "model-step-reference/v1",
      "authorization": "S4 approved job + current lease generation + explicit delegated native session + shared job budget; S3 isolated compatibility fixture remains explicit",
      "approved_job_supervisor_timeout_seconds": 45,
      "approved_job_native_timeout_seconds": 50
    },
    {
      "name": "scat_model_run",
      "version": "1.0.0",
      "description": "用 input 引用执行可信任务已批准的注册模型；unknown 不得自动重试。",
      "parameters": {
        "$defs": {
          "StepReference": {
            "additionalProperties": false,
            "properties": {
              "schema_version": {
                "default": "model-step-reference/v1",
                "pattern": "^model-step-reference/v1$",
                "title": "Schema Version",
                "type": "string"
              },
              "artifact_id": {
                "pattern": "^[0-9a-f]{32}$",
                "title": "Artifact Id",
                "type": "string"
              },
              "kind": {
                "pattern": "^(input|prediction|evaluation|result)$",
                "title": "Kind",
                "type": "string"
              },
              "content_sha256": {
                "pattern": "^[0-9a-f]{64}$",
                "title": "Content Sha256",
                "type": "string"
              }
            },
            "required": [
              "artifact_id",
              "kind",
              "content_sha256"
            ],
            "title": "StepReference",
            "type": "object"
          }
        },
        "additionalProperties": false,
        "properties": {
          "reference": {
            "$ref": "#/$defs/StepReference"
          }
        },
        "required": [
          "reference"
        ],
        "title": "Referenced",
        "type": "object"
      },
      "input_kind": "input",
      "output_kind": "prediction",
      "effect_kind": "compute",
      "environment_alias": "scat-agent",
      "supervisor_timeout_seconds": 20,
      "native_timeout_seconds": 25,

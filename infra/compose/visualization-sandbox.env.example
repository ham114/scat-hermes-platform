# Host systemd EnvironmentFile, chmod 600. Paths match the Compose shared volume.
# No DS/Qwen, Mongo, Honcho or main Agent credentials belong here.
SCAT_VIS_SANDBOX_IMAGE=sha256:REPLACE_WITH_VERIFIED_LOCAL_RENDERER_ID
HERMES_TASK_STATE_FILE=var/deploy/h7b/shared/state/tasks.sqlite
SCAT_VIS_ARTIFACT_ROOT=var/deploy/h7b/shared/visualizations
SCAT_VIS_SANDBOX_KEY_FILE=var/deploy/h7b/secrets/visualization-sandbox.key

# 独立GPU运行profile；复用已有Anaconda和私有供应商凭据。
# 本文件是配置样例，不自动挂载到当前运行容器。
SCAT_GPU_CONFIG_FILE=var/gpu/production.json
SCAT_SKILL_RELEASE_STATE=var/gpu/catalog.sqlite
HERMES_TASK_STATE_FILE=var/gpu/tasks.sqlite
HERMES_STATE_FILE=var/gpu/platform.sqlite
HERMES_RESULT_STATE_FILE=var/gpu/results.sqlite
ANALYSIS_IDENTITY_MODE=single_user
ANALYSIS_SINGLE_USER_ID=scat-researcher
ANALYSIS_RUNS_COLLECTION=analysis_runs_hermes_gpu
ANALYSIS_ARTIFACTS_COLLECTION=analysis_artifacts_hermes_gpu
HERMES_SKILL_JOBS_ENABLED=true
HERMES_WORKFLOWS_ENABLED=true
SCAT_S5_WORKFLOWS=1
SCAT_S5_SYNTHETIC=0

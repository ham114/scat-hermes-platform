# Draft only: not loaded by any current container. Do not put real keys here.
# The private server copy is var/deploy/honcho/secrets/honcho.env (mode 0600).
# USER: fill this one value with the independent DeepSeek key named scat-honcho-memory.
# LLM_OPENAI_API_KEY is Honcho's OpenAI-compatible transport variable, not a request for an OpenAI account.
LLM_OPENAI_API_KEY=

# OPERATOR: generate during deployment; leave blank for now.
HONCHO_API_KEY=
AUTH_USE_AUTH=true
AUTH_JWT_SECRET=
DB_CONNECTION_URI=
HONCHO_EMBEDDING_API_KEY=

LOG_LEVEL=INFO
API_WORKERS=1
CACHE_ENABLED=false
VECTOR_STORE_TYPE=pgvector
TELEMETRY_ENABLED=false
TELEMETRY_TRACE_PAYLOADS_ENABLED=false
REASONING_TRACES_FILE=

# Local BGE-M3 compatible endpoint is PLANNED, not the current RAG /search endpoint.
EMBED_MESSAGES=true
EMBEDDING_VECTOR_DIMENSIONS=1024
EMBEDDING_MODEL_CONFIG__TRANSPORT=openai
EMBEDDING_MODEL_CONFIG__MODEL=bge-m3
EMBEDDING_MODEL_CONFIG__OVERRIDES__BASE_URL=http://127.0.0.1:18141/v1
EMBEDDING_MODEL_CONFIG__OVERRIDES__API_KEY_ENV=HONCHO_EMBEDDING_API_KEY
EMBEDDING_MODEL_CONFIG__MAX_BATCH_SIZE=8

DERIVER_ENABLED=true
DERIVER_WORKERS=1
DERIVER_FLUSH_ENABLED=false
DERIVER_MODEL_CONFIG__TRANSPORT=openai
DERIVER_MODEL_CONFIG__MODEL=deepseek-flash
DERIVER_MODEL_CONFIG__OVERRIDES__BASE_URL=https://api.deepseek.com
DERIVER_MODEL_CONFIG__STRUCTURED_OUTPUT_MODE=json_object
DERIVER_MODEL_CONFIG__MAX_OUTPUT_TOKENS=2048
DERIVER_MAX_INPUT_TOKENS=12000
DERIVER_LOG_OBSERVATIONS=false

SUMMARY_ENABLED=true
SUMMARY_MODEL_CONFIG__TRANSPORT=openai
SUMMARY_MODEL_CONFIG__MODEL=deepseek-flash
SUMMARY_MODEL_CONFIG__OVERRIDES__BASE_URL=https://api.deepseek.com
SUMMARY_MESSAGES_PER_SHORT_SUMMARY=20
SUMMARY_MESSAGES_PER_LONG_SUMMARY=60
SUMMARY_MAX_TOKENS_SHORT=400
SUMMARY_MAX_TOKENS_LONG=1200
SUMMARY_MAX_INPUT_TOKENS=12000

DIALECTIC_MAX_INPUT_TOKENS=12000
DIALECTIC_MAX_OUTPUT_TOKENS=512
DIALECTIC_SESSION_HISTORY_MAX_TOKENS=2048
DIALECTIC_LEVELS__minimal__MODEL_CONFIG__TRANSPORT=openai
DIALECTIC_LEVELS__minimal__MODEL_CONFIG__MODEL=deepseek-flash
DIALECTIC_LEVELS__minimal__MODEL_CONFIG__OVERRIDES__BASE_URL=https://api.deepseek.com
DIALECTIC_LEVELS__low__MODEL_CONFIG__TRANSPORT=openai
DIALECTIC_LEVELS__low__MODEL_CONFIG__MODEL=deepseek-flash
DIALECTIC_LEVELS__low__MODEL_CONFIG__OVERRIDES__BASE_URL=https://api.deepseek.com
DIALECTIC_LEVELS__low__MAX_TOOL_ITERATIONS=2
DIALECTIC_LEVELS__medium__MODEL_CONFIG__TRANSPORT=openai
DIALECTIC_LEVELS__medium__MODEL_CONFIG__MODEL=deepseek-flash
DIALECTIC_LEVELS__medium__MODEL_CONFIG__OVERRIDES__BASE_URL=https://api.deepseek.com
DIALECTIC_LEVELS__high__MODEL_CONFIG__TRANSPORT=openai
DIALECTIC_LEVELS__high__MODEL_CONFIG__MODEL=deepseek-flash
DIALECTIC_LEVELS__high__MODEL_CONFIG__OVERRIDES__BASE_URL=https://api.deepseek.com
DIALECTIC_LEVELS__max__MODEL_CONFIG__TRANSPORT=openai
DIALECTIC_LEVELS__max__MODEL_CONFIG__MODEL=deepseek-flash
DIALECTIC_LEVELS__max__MODEL_CONFIG__OVERRIDES__BASE_URL=https://api.deepseek.com

DREAM_ENABLED=false
DREAM_DEDUCTION_MODEL_CONFIG__TRANSPORT=openai
DREAM_DEDUCTION_MODEL_CONFIG__MODEL=deepseek-flash
DREAM_DEDUCTION_MODEL_CONFIG__OVERRIDES__BASE_URL=https://api.deepseek.com
DREAM_INDUCTION_MODEL_CONFIG__TRANSPORT=openai
DREAM_INDUCTION_MODEL_CONFIG__MODEL=deepseek-flash
DREAM_INDUCTION_MODEL_CONFIG__OVERRIDES__BASE_URL=https://api.deepseek.com
